# NVD API Configuration
# Get your API key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here

# Discord Configuration
# Create a webhook in your Discord server settings
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Application Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (optional - defaults to SQLite in data/ directory)
# DB_PATH=/app/data/nvd_scanner.db

# Docker User Configuration (for rootless Docker compatibility)
# Set these to match your current user ID and group ID
# Run: id -u and id -g to get your values
# If not set, containers will run as root (not recommended for production)
USER_ID=1000
GROUP_ID=1000
