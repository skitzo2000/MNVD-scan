# NVD API Configuration
# Get your API key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here

# Discord Configuration
# Create a webhook in your Discord server settings
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Application Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (optional - defaults to SQLite in data/ directory)
# DB_PATH=/app/data/nvd_scanner.db

# Docker User Configuration (for rootless Docker compatibility)
# Set these to match your current user ID and group ID
# Run: id -u and id -g to get your values
# If not set, containers will run as root (not recommended for production)
USER_ID=1000
GROUP_ID=1000

# Docker Image Version (optional - for versioned deployments)
# Specify a version tag to use a specific release
# Examples: latest, v1.0.0, v1.2.3, or a commit SHA
# Default: latest
# IMAGE_TAG=latest

# Security Configuration
# API key for authenticating requests to the backend
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# CORS origin restriction (defaults to http://frontend:3000)
# CORS_ORIGIN=http://frontend:3000

# Encryption key for webhook URLs stored at rest (32 bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_ENCRYPTION_KEY=
